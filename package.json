{
  "name": "playwright-automation-framework",
  "version": "1.0.0",
  "description": "Enterprise-grade Playwright automation framework with TypeScript — Omnivva HMS",
  "scripts": {
    "pretest": "node scripts/allure-runner.js clean",
    "test": "npx playwright test tests/e2e/ --workers=5",
    "test:patient": "npx playwright test tests/e2e/patient-portal.spec.ts --workers=5",
    "test:staff": "npx playwright test tests/e2e/staff-portal.spec.ts --workers=5",
    "test:appointment": "npx playwright test tests/e2e/appointment-flow.spec.ts --workers=5",
    "test:flows": "npx playwright test tests/e2e/flow-check-specialties/ --workers=1",
    "test:flows:ui": "npx playwright test tests/e2e/flow-check-specialties/ --ui",
    "test:booking": "npx playwright test tests/e2e/flow-check-specialties/ --grep \"@booking\" --workers=1",
    "test:booking:ui": "npx playwright test tests/e2e/flow-check-specialties/ --grep \"@booking\" --ui",
    "test:reception": "npx playwright test tests/e2e/flow-check-specialties/ --grep \"@reception\" --workers=1",
    "test:reception:ui": "npx playwright test tests/e2e/flow-check-specialties/ --grep \"@reception\" --ui",
    "test:dental": "npx playwright test tests/e2e/flow-check-specialties/dental",
    "test:specialties": "npx playwright test tests/e2e/doctor-specialties.spec.ts --workers=5",
    "test:menus": "npx playwright test tests/e2e/staff-portal.spec.ts --grep \"@menus\" --workers=5",
    "test:headed": "npx playwright test tests/e2e/ --headed --workers=1",
    "test:smoke": "npx playwright test --grep \"@smoke\" --workers=5",
    "test:regression": "npx playwright test --grep \"@regression\" --workers=5",
    "test:api": "npx playwright test --project=api",
    "report:html": "npx playwright show-report reports/html",
    "report:excel": "node scripts/generate-excel-report.js",
    "report:allure:clean": "node scripts/allure-runner.js clean",
    "report:allure:generate": "node scripts/allure-runner.js generate",
    "report:allure:open": "node scripts/allure-runner.js open",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^25.5.2",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "allure-js-commons": "^3.0.0",
    "allure-commandline": "^2.30.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^16.4.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-playwright": "^2.1.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "winston": "^3.17.0"
  }
}
