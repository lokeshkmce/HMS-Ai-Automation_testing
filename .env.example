# ─── Environment ────────────────────────────────────────────────────────────
# Target environment: dev | qa | prod
TEST_ENV=dev

# ─── Application URLs ───────────────────────────────────────────────────────
BASE_URL=https://dev.omnivva.com
IDENTITY_BASE_URL=https://dev-identity.srivyn.in
API_BASE_URL=https://jsonplaceholder.typicode.com

# ─── API Authentication ──────────────────────────────────────────────────────
# Bearer token for protected API endpoints (leave blank if not required)
API_TOKEN=

# ─── Role-Based QA Account Passwords ────────────────────────────────────────
# IMPORTANT: Never commit real passwords. Fill these in locally or inject via CI secrets.
QA_PASSWORD_DOCTOR=
QA_PASSWORD_NURSE=
QA_PASSWORD_RECEPTION=
QA_PASSWORD_BILLING=
QA_PASSWORD_LABORATORY=
QA_PASSWORD_RADIOLOGY=
QA_PASSWORD_PHARMACY=
QA_PASSWORD_ADMINISTRATION=
QA_PASSWORD_GROUP_ADMIN=

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=info
