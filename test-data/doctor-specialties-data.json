{
  "suite": "Omnivva HMS — Specialty-Wise Doctor Portal Login & Dashboard Validation",
  "environment": "dev",
  "defaultPassword": "password123",

  "invalidLogins": [
    {
      "id": "TC_DOC_LOGIN_INV_PASSWORD",
      "specialtyName": "Neurosurgery",
      "username": "qa.neurosurgery@omnivva.com",
      "password": "WrongPassword999!",
      "description": "Valid doctor email with incorrect password shows error and rejects login",
      "expectedResult": "error",
      "tag": "@smoke @regression @negative"
    },
    {
      "id": "TC_DOC_LOGIN_INV_USER",
      "specialtyName": "Unknown Specialty",
      "username": "nonexistent.doctor@omnivva.com",
      "password": "password123",
      "description": "Non-existent doctor account shows error and rejects login",
      "expectedResult": "error",
      "tag": "@regression @negative"
    },
    {
      "id": "TC_DOC_LOGIN_INV_EMPTY",
      "specialtyName": "Empty Fields",
      "username": "",
      "password": "",
      "description": "Empty doctor username and password fields show validation error",
      "expectedResult": "validation_error",
      "tag": "@regression @negative"
    },
    {
      "id": "TC_DOC_LOGIN_INV_FORMAT",
      "specialtyName": "Invalid Format",
      "username": "qa.cardiosurgery.invalid-email",
      "password": "password123",
      "description": "Invalid doctor email format is rejected",
      "expectedResult": "error",
      "tag": "@regression @negative"
    },
    {
      "id": "TC_DOC_LOGIN_INV_SQLI",
      "specialtyName": "Security SQLi",
      "username": "' OR '1'='1",
      "password": "' OR '1'='1",
      "description": "SQL Injection attempt in doctor login fields is rejected safely",
      "expectedResult": "error",
      "tag": "@security @regression @negative"
    },
    {
      "id": "TC_DOC_LOGIN_INV_XSS",
      "specialtyName": "Security XSS",
      "username": "<script>alert('xss-doc')</script>",
      "password": "password123",
      "description": "XSS payload in doctor login username is sanitized and rejected",
      "expectedResult": "error",
      "tag": "@security @regression @negative"
    },
    {
      "id": "TC_DOC_LOGIN_INV_DOMAIN",
      "specialtyName": "Wrong Domain",
      "username": "qa.neurology@unauthorized-external-domain.com",
      "password": "password123",
      "description": "Doctor login attempt from unauthorized external domain is rejected",
      "expectedResult": "error",
      "tag": "@security @regression @negative"
    },
    {
      "id": "TC_DOC_LOGIN_INV_SPECIAL_CHARS",
      "specialtyName": "Special Characters",
      "username": "qa.cardio!#$%^&*@omnivva.com",
      "password": "password123",
      "description": "Doctor username containing invalid special characters is rejected",
      "expectedResult": "error",
      "tag": "@security @regression @negative"
    }
  ],

